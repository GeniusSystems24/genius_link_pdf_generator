        'INV-2026-000123 و 15,697.50 SAR. ';
    const en =
        'Long English content validates multi-page direction with '
        'INV-2026-000123 and 15,697.50 SAR. ';
    for (var p = 0; p < 3; p++) {
      if (p > 0) newPage();
      addLine('S02 page ${p + 1}/3');
      for (var i = 0; i < 10; i++) {
        addLine(config.isRTL ? '$ar$ar' : '$en$en', topMargin: 6);
      }
      summary();
    }
